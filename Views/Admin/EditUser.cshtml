@model CinemaTicketSystem.Models.AdminEditUserViewModel

@{
    ViewData["Title"] = "Edit User";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h2 class="card-title text-center mb-4">Edit User Profile</h2>
                <form asp-action="EditUser" method="post">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="ConcurrencyToken" />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="FirstName" class="form-label">First Name</label>
                            <input asp-for="FirstName" class="form-control" />
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="LastName" class="form-label">Last Name</label>
                            <input asp-for="LastName" class="form-control" />
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PhoneNumber" class="form-label">Phone Number</label>
                        <input asp-for="PhoneNumber" class="form-control" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning flex-grow-1">Save changes</button>
                        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                    </div>
                </form>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <h4 class="card-title mb-4">User Reservations</h4>
                
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
                }

                @if (!Model.Reservations.Any())
                {
                    <p class="text-muted">This user has no reservations.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Movie</th>
                                    <th>Cinema / Time</th>
                                    <th>Current Seat</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var res in Model.Reservations)
                                {
                                    <tr>
                                        <td>
                                            <strong>@res.MovieTitle</strong>
                                        </td>
                                        <td>
                                            <small class="d-block">@res.CinemaName</small>
                                            <small class="text-muted">@res.StartTime.ToString("g")</small>
                                        </td>
                                        <td>
                                            <span class="badge bg-info text-dark">Row @res.CurrentRow, Seat @res.CurrentSeat</span>
                                        </td>
                                        <td>
                                            <div class="d-flex gap-2">
                                                <form asp-action="ChangeUserSeat" method="post" class="d-flex gap-1">
                                                    <input type="hidden" name="userId" value="@Model.Id" />
                                                    <input type="hidden" name="reservationId" value="@res.ReservationId" />
                                                    <select name="selectedNewSeat" asp-items="res.FreeSeatsOptions" class="form-select form-select-sm" style="width: auto;">
                                                    </select>
                                                    <button type="submit" class="btn btn-outline-primary btn-sm">Move</button>
                                                </form>

                                                <form asp-action="DeleteUserReservation" method="post" onsubmit="return confirm('Are you sure you want to delete this reservation?');">
                                                    <input type="hidden" name="userId" value="@Model.Id" />
                                                    <input type="hidden" name="reservationId" value="@res.ReservationId" />
                                                    <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>