@model CinemaTicketSystem.Models.EditProfileViewModel

@{
    ViewData["Title"] = "Редактирование пользователя (Админ)";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h2 class="text-center mb-4">Change user profile</h2>

        <form asp-action="EditUser" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ConcurrencyToken" />

            <div class="mb-3">
                <label asp-for="FirstName" class="form-label">First name</label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="LastName" class="form-label">Last name</label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PhoneNumber" class="form-label">Phone number</label>
                <input asp-for="PhoneNumber" class="form-control" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-warning w-100">Save changes</button>
            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary w-100 mt-2">Отмена</a>
        </form>
    </div>
</div>