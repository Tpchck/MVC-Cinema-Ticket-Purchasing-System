@model IEnumerable<CinemaTicketSystem.Models.Screening>
@{
    ViewData["Title"] = "Upcoming Screenings";
}

<div class="container mt-5">
    <h1 class="text-center mb-5 fw-bold text-primary">Now Showing</h1>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">No upcoming screenings available at the moment.</div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var screening in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 bg-light">
                        <div class="card-body text-center">
                            <h4 class="card-title fw-bold text-dark mb-3">@screening.MovieTitle</h4>
                            <p class="card-text text-muted mb-1"><i class="bi bi-geo-alt-fill"></i> @screening.Cinema?.Name</p>
                            <p class="card-text text-muted mb-4"><i class="bi bi-clock-fill"></i> @screening.StartTime.ToString("f")</p>
                            <a asp-controller="Reservation" asp-action="SeatMap" asp-route-screeningId="@screening.Id" class="btn btn-outline-primary w-100 rounded-pill shadow-sm">
                                View Seats &amp; Book
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
