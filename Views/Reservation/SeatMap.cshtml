@model CinemaTicketSystem.Models.SeatMapViewModel

@{
    ViewData["Title"] = "Seat Map";
}

<div class="container my-5">
    <h2 class="text-center mb-1">@Model.Screening.MovieTitle</h2>
    <h5 class="text-center text-muted mb-4">@Model.Screening.Cinema?.Name - @Model.Screening.StartTime.ToString("g")</h5>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger text-center">@TempData["ErrorMessage"]</div>
    }
    <!-- Screen representation -->
    <div class="d-flex justify-content-center mb-5">
        <div id="cinema-screen" class="bg-dark text-white text-center py-2 rounded shadow-sm fw-bold" style="width: 100%; max-width: 1200px; letter-spacing: 5px; border-bottom: 5px solid #0d6efd;">
            SCREEN
        </div>
    </div>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <form asp-action="BookSeat" method="post">
            <input type="hidden" name="screeningId" value="@Model.Screening.Id" />
            
            <!-- Seat layout using CSS Grid -->
            <div class="d-flex justify-content-center mb-4 overflow-hidden">
                <div class="seat-map-wrapper w-100" style="max-width: 1200px;">
                    <div class="seat-map" style="display: grid; gap: 4px; grid-template-columns: repeat(@(Model.Screening.Cinema?.SeatsPerRow ?? 1), 1fr);">
                        @for (int row = 1; row <= (Model.Screening.Cinema?.Rows ?? 0); row++)
                        {
                            @for (int seat = 1; seat <= (Model.Screening.Cinema?.SeatsPerRow ?? 0); seat++)
                            {
                                var reservation = Model.ExistingReservations.FirstOrDefault(r => r.RowPosition == row && r.SeatPosition == seat);
                                string seatId = $"seat-{row}-{seat}";

                                if (reservation != null)
                                {
                                    if (reservation.UserId == Model.CurrentUserId)
                                    {
                                        <div class="seat-container">
                                            <button type="submit" asp-action="CancelSeat" name="reservationId" value="@reservation.Id" class="btn btn-primary btn-sm w-100 p-0 d-flex align-items-center justify-content-center border-0 shadow-sm" title="Cancel your seat" style="aspect-ratio: 1/1; font-size: 0.6rem; min-width: 20px;">
                                                ✓
                                            </button>
                                            <input type="hidden" name="screeningId" value="@Model.Screening.Id" />
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="seat-container">
                                            <button type="button" class="btn btn-secondary btn-sm w-100 p-0 opacity-25 d-flex align-items-center justify-content-center border-0" disabled style="aspect-ratio: 1/1; font-size: 0.6rem; min-width: 20px;">
                                                x
                                            </button>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="seat-container">
                                        <input type="radio" name="seatCoordinates" value="@row-@seat" id="@seatId" class="btn-check" required />
                                        <label class="btn btn-outline-success btn-sm w-100 p-0 d-flex align-items-center justify-content-center border-1 shadow-sm" for="@seatId" style="aspect-ratio: 1/1; font-size: 0.6rem; min-width: 20px;">
                                            @seat
                                        </label>
                                    </div>
                                }
                            }
                        }
                    </div>
                </div>
            </div>

            <div class="text-center mt-5">
                <button type="submit" class="btn btn-success btn-lg px-5 rounded-pill shadow-lg border-0 transition-hover">Confirm Selection &amp; Reserve Seat</button>
            </div>
        </form>
    }
    else
    {
        <div class="alert alert-warning text-center rounded-pill mb-5">Please <a asp-controller="Account" asp-action="Login" class="fw-bold">Login</a> to reserve seats.</div>
        <!-- Read-only view of the hall -->
        <div class="d-flex justify-content-center mb-4 overflow-hidden">
             <div class="seat-map-wrapper w-100" style="max-width: 1200px;">
                <div class="seat-map" style="display: grid; gap: 4px; grid-template-columns: repeat(@(Model.Screening.Cinema?.SeatsPerRow ?? 1), 1fr);">
                    @for (int row = 1; row <= (Model.Screening.Cinema?.Rows ?? 0); row++)
                    {
                        @for (int seat = 1; seat <= (Model.Screening.Cinema?.SeatsPerRow ?? 0); seat++)
                        {
                            var reservation = Model.ExistingReservations.FirstOrDefault(r => r.RowPosition == row && r.SeatPosition == seat);
                            if (reservation != null)
                            {
                                <button type="button" class="btn btn-secondary btn-sm w-100 p-0 opacity-25 border-0" disabled style="aspect-ratio: 1/1; font-size: 0.6rem; min-width: 20px;">x</button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-outline-success btn-sm w-100 p-0 border-1" disabled style="aspect-ratio: 1/1; font-size: 0.6rem; min-width: 20px;">@seat</button>
                            }
                        }
                    }
                </div>
            </div>
        </div>
    }

    <!-- Legend -->
    <div class="d-flex justify-content-center mt-4 gap-4 flex-wrap">
        <div class="d-flex align-items-center gap-2">
            <span class="btn btn-success btn-sm shadow-sm" style="width: 30px; height: 30px; display: inline-block;"></span>
            <span>Free</span>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="btn btn-primary btn-sm shadow-sm" style="width: 30px; height: 30px; display: inline-block;"></span>
            <span>Your Seat</span>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="btn btn-secondary btn-sm shadow-sm opacity-50" style="width: 30px; height: 30px; display: inline-block;"></span>
            <span>Occupied</span>
        </div>
    </div>
</div>
